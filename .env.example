# ============================================================
# 复制此文件为 .env，填入真实值
# cp .env.example .env
# ⚠️  .env 不提交到 Git！
# ============================================================

# ============================================================
# 微信小程序
# 获取地址：微信公众平台 → 开发管理 → 开发设置
# ============================================================
WECHAT_APP_ID=wxYOUR_APPID_HERE
WECHAT_APP_SECRET=your_app_secret_here

# ============================================================
# 微信支付 v3
# 获取地址：微信支付商户平台 → 账户中心 → API 安全
# ============================================================
WECHAT_PAY_MCH_ID=your_mch_id_here
WECHAT_PAY_API_KEY_V3=your_v3_api_key_here
WECHAT_PAY_CERT_SERIAL_NO=your_cert_serial_number_here
# 证书文件存放路径（不提交到 Git）
WECHAT_PAY_CERT_PATH=backend/wechat_pay_cert/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=backend/wechat_pay_cert/apiclient_key.pem
# 支付回调地址（生产环境替换为真实域名）
WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/api/v1/webhooks/wechat-pay

# ============================================================
# 数据库（PostgreSQL）
# 本地开发：docker-compose 启动的本地数据库
# 生产环境：TencentDB for PostgreSQL 连接字符串
# ============================================================
DATABASE_URL=postgresql://ptmgmt_user:ptmgmt_password@localhost:5432/ptmgmt

# ============================================================
# Redis
# 本地开发：docker-compose 启动的本地 Redis
# 生产环境：腾讯云 Redis 连接地址
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# JWT 认证
# JWT_SECRET_KEY 至少 32 个随机字符
# 生成命令：python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
JWT_SECRET_KEY=CHANGE_ME_to_a_very_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# 腾讯云 COS（对象存储）
# 获取地址：腾讯云控制台 → 访问密钥
# ============================================================
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=ptmgmt-files-1234567890
COS_REGION=ap-guangzhou
COS_BASE_URL=https://ptmgmt-files-1234567890.cos.ap-guangzhou.myqcloud.com

# ============================================================
# 腾讯云短信 SMS（Phase 2 Web 端登录）
# 暂时留空，Phase 2 实施时填入
# ============================================================
# SMS_SECRET_ID=
# SMS_SECRET_KEY=
# SMS_APP_ID=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_ID_LOGIN=

# ============================================================
# 应用配置
# ============================================================
APP_ENV=development          # development | staging | production
APP_NAME=PT-MGMT
APP_DEBUG=true               # 生产环境改为 false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 转介绍奖励有效期（天）
REFERRAL_EXPIRY_DAYS=90
