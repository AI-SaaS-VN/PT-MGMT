/* pages/my-balance/my-balance.wxss */

/* ── 加载中 ── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: var(--color-text-secondary);
}

.loading-text {
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* ── Banner ── */
.banner {
  background: linear-gradient(135deg, #1565C0 0%, #1976D2 100%);
  padding: 48rpx 40rpx 64rpx;
  color: #ffffff;
}

.banner-user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.banner-name {
  font-size: 36rpx;
  font-weight: 600;
}

.banner-logout {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
}

.banner-total {
  display: flex;
  align-items: baseline;
}

.banner-total-num {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  margin-right: 12rpx;
}

.banner-total-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ── 课包列表 ── */
.pkg-list {
  padding: 0 0 32rpx;
  margin-top: -24rpx; /* 与 banner 重叠，营造层叠感 */
}

.pkg-card {
  background: var(--color-card-bg);
  border-radius: 20rpx;
  padding: 36rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 课包头部 */
.pkg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.pkg-course {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 课时数字 */
.pkg-progress-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
}

.pkg-remaining {
  display: flex;
  align-items: baseline;
}

.remaining-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.remaining-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-left: 4rpx;
}

.remaining-tip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 进度条 */
.progress-bar-bg {
  height: 12rpx;
  background: var(--color-primary-light);
  border-radius: 6rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 详情行 */
.pkg-details {
  border-top: 1rpx solid var(--color-border);
  padding-top: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.detail-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.detail-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}
