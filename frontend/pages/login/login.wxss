/* pages/login/login.wxss */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(160deg, #1976D2 0%, #42A5F5 100%);
  padding: 0 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-placeholder {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 32rpx;
  letter-spacing: 4rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-wechat {
  width: 100%;
  background: #ffffff;
  color: #1976D2;
  border: none;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.btn-wechat.loading {
  opacity: 0.7;
}

.error-msg {
  color: #FFCDD2;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.hint {
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
  margin-top: 8rpx;
}
